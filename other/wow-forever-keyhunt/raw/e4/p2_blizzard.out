}(window, document, 0, "appendFrame");</script><header><blz-nav hidden="hidden" content="wow-site-homepage" user-endpoint="/nav/authenticate" theme="wow-site-homepage" search-url="https://worldofwarcraft.blizzard.com/search?q={value}"><script src="https://navbar.blizzard.com/static/v1/nav.js" async="async"></script></blz-nav><script>(() => {
  if (nav = document.querySelector('blz-nav, blz-nav-battlenet')) {
    nav.addEventListener('blz-nav:cms-loaded', ({detail}) => {
      detail.cmsContent.filter((e) => ['/login', '/logout', '/?logout'].includes(e.href)).forEach((e) => {
        e.setAttribute('href', `${e.href}?redirect=${window.location.pathname}`)
      })
    })
  }
})();
</script></header><script>(() => {
if (customNav = document.querySelector('blz-nav, blz-nav-battlenet')) {
    customNav.addEventListener('blz-nav:cms-loaded', ({ detail }) => {
    detail.cmsContent
        .filter((e) => !!e.href
            // relative/anchor links only
            && (e.href.startsWith('/') || e.href.startsWith('#'))
            // skip manipulating login/logout segments as it is already handled
            && !['/login', '/?login', '/logout', '/?logout'].some(item => e.href.startsWith(item)))
        .forEach((e) => {
            const locale = 'en_US';
            const normalizedLocale = locale.replaceAll('_', '-').toLowerCase();
            const absoluteUrl = `https://worldofwarcraft.blizzard.com/${normalizedLocale}${e.href}`;
            e.setAttribute('href', absoluteUrl);
        });
    })
}
})();</script><main class="main-content"><main class="main-container"><blz-news-featured-cards class="section-featured-news" header-text="Featured Articles" error-header-text="Uh oh!" error-message-text="An unexpected error occurred." error-sub-message-text="Check your connection and try refreshing the page, or try again later." error-refresh-button-label="Refresh" news-label-text="News" patch-notes-label-text="Patch Notes"></blz-news-featured-cards><div class="LatestNews theme-bg"><section class="LatestNews-feed"><blz-header slot="2"><h2 slot="heading">Latest Articles</h2></blz-header><blz-news-feed slot="2" load-more-button-label="Load More" load-more-error-message-text="An unexpected error occurred while loading more news." load-more-error-sub-message-text="Please try again, or try refreshing the page if the issue persists." no-content-message-text="No additional content available." news-label-text="News" patch-notes-label-text="Patch Notes"></blz-news-feed></section></div><blz-news-event-manager product="world-of-warcraft"></blz-news-event-manager></main></main><blz-nav-footer><script src="https://navbar.blizzard.com/static/v1/footer.js" async="async"></script></blz-nav-footer></body></html>