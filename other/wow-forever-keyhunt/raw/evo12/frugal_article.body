    <script>
    (function () {

        function cleanHeaderLabels(root) {
            root.querySelectorAll('.tablepress thead tr:first-child th, .tablepress tbody tr:first-child td')
                .forEach(function (cell) {
                    var text = (cell.textContent || '').trim();

                    if (text.startsWith('Description') || text.startsWith('Expiry Date')) {
                        cell.textContent = text.replace(/\s+\d+$/, '');
                    }
                });
        }

        function cleanLimitedTimeOnly(root) {
            root.querySelectorAll('.tablepress th, .tablepress td')
                .forEach(function (cell) {
                    var text = cell.textContent || '';
                    if (!text.includes('Limited Time Only')) return;

                    // Replace every occurrence like:
                    // "Limited Time Only*" / "Limited Time Only^" / "Limited Time Only-"
                    // including repeats within the same table/cell
                    var cleaned = text.replace(/Limited Time Only[\s\u00A0]*[\*\^\-]+/g, 'Limited Time Only');

                    if (cleaned !== text) {
                        cell.textContent = cleaned;
                    }
                });
        }

        function runAll() {
            cleanHeaderLabels(document);
            cleanLimitedTimeOnly(document);
        }

        function onReady(fn) {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fn);
            } else {
                fn();
            }
        }

        onReady(function () {
            runAll();

            // If TablePress DataTables redraws the table, re-run cleanup
            if (window.jQuery) {
                window.jQuery(document).on('draw.dt', function () {
                    runAll();
                });
            }

            // If tables are injected/updated after load, re-run cleanup (throttled)
            var scheduled = false;
            var obs = new MutationObserver(function () {
                if (scheduled) return;
                scheduled = true;
                requestAnimationFrame(function () {
                    scheduled = false;
                    runAll();
                });
            });

            if (document.body) {
                obs.observe(document.body, { childList: true, subtree: true, characterData: true });
            }
        });

    })();
    </script>
