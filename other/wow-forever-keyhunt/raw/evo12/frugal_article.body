<style id="wp-custom-css">
/* === FrugalFeeds — Hueman CSS (system fonts, CLS-safe) === */

/* --- Base / resets --- */
*, *::before, *::after {
  box-sizing: border-box;
}

html {
  line-height: 1.4;
}

body {
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
}

/* --- Utility / small fixes --- */
.page-image {
  display: none;
}

.site-title {
  padding: 0;
}

#header .pad,
#header .hu-pad {
  padding-top: 0;
  padding-bottom: 0;
}

/* Avoid duplicate declarations */
ins.adsbygoogle {
  background: transparent;
}

/* Hide items that aren’t needed */
.single-post .post-tags {
  display: none;
}

.comment-form-url {
  display: none;
}

/* Entry images: keep CLS-safe but allow inline use with text */
.entry img {
  display: inline-block;
  height: auto;
  max-width: 100%;
  min-inline-size: 1px;
  vertical-align: middle;
}

/* Large content images can still be full-width blocks */
.entry img.size-large,
.entry img.size-full,
.entry img.aligncenter {
  display: block;
  margin-inline: auto;
}

/* Remove mobile upscaling that can distort and bloat LCP */
@media (max-width: 600px) {
  .entry img.size-medium {
    max-width: 100%;
    width: auto;
  }
}

/* Headings: predictable spacing and line-height */
.entry h1,
.entry h2,
.entry h3,
.entry h4,
.entry h5,
.entry h6 {
  margin: 0 0 .75em;
  line-height: 1.2;
}

.entry h2 {
  font-weight: 700;
}

/* Titles: scope tighter to listing widgets to avoid global clashes */
.display-posts-listing.image-left .title,
.display-posts-listing.image-left2 .title,
.display-posts-listing.image-home .title,
.display-posts-listing.image-top .listing-item .title {
  display: block;
  font-weight: bold;
}

/* Fluid top title instead of breakpoint jump */
#top .title {
  font-size: clamp(1.125rem, 2.5vw + .5rem, 1.75rem);
}

/* Listing layouts: switch from floats to flex to reduce reflows */
.display-posts-listing.image-left .listing-item,
.display-posts-listing.image-left2 .listing-item,
.display-posts-listing.image-home .listing-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 16px;
}

/* Link colors in widgets */
.widget a.rsswidget {
  color: #000;
}

/* =========================================================
   ADS — safer Google AdSense / Auto Ads handling
   ========================================================= */

/* Do not force all AdSense units to 250px high.
   This prevents mobile Auto Ads and anchor-like units from leaving large blank gaps. */
.adsbygoogle,
.ad-slot,
ins.adsbygoogle {
  display: block;
  max-width: 100%;
  overflow: hidden;
  background: transparent;
}

/* Centre normal in-page ad units */
.ad-slot,
ins.adsbygoogle {
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}

/* Only reserve space for specific ad placements you manually control */
.ad-300x250 {
  min-height: 250px;
  min-width: 300px;
}

.ad-336x280 {
  min-height: 280px;
  min-width: 336px;
}

.ad-320x100 {
  min-height: 100px;
  min-width: 320px;
}

.ad-320x50 {
  min-height: 50px;
  min-width: 320px;
}

.ad-728x90 {
  min-height: 90px;
  min-width: 728px;
}

.ad-970x250 {
  min-height: 250px;
  min-width: 970px;
}

.ad-300x600 {
  min-height: 600px;
  min-width: 300px;
}

/* Mobile ad safety: prevent 414px/430px Google iframes overflowing or appearing off-centre */
@media (max-width: 600px) {
  .adsbygoogle,
  .ad-slot,
  ins.adsbygoogle {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin-left: auto !important;
    margin-right: auto !important;
    overflow: hidden !important;
    text-align: center !important;
  }

  .adsbygoogle iframe,
  ins.adsbygoogle iframe,
  iframe[id^="aswift_"],
  iframe[name^="aswift_"] {
    max-width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  iframe[id^="aswift_"] {
    width: 100% !important;
    max-width: 100vw !important;
  }

  div[id^="google_ads_iframe_"],
  ins.adsbygoogle {
    max-width: 100% !important;
    overflow: hidden !important;
  }

  /* Avoid desktop ad reservations forcing horizontal overflow on mobile */
  .ad-728x90,
  .ad-970x250,
  .ad-300x600,
  .ad-336x280,
  .ad-300x250,
  .ad-320x100,
  .ad-320x50 {
    min-width: 0 !important;
    max-width: 100% !important;
  }
}

/* Responsive embeds with stable box */
.responsive-embed,
.entry iframe[src*="youtube"],
.entry iframe[src*="vimeo"] {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  height: auto;
}

/* Hide-on-device utilities */
@media (max-width: 480px) {
  .hide_on_mobile {
    display: none !important;
  }
}

@media (min-width: 481px) {
  .hide_on_desktop {
    display: none !important;
  }
}

/* Headings inside entries: keep simple */
.entry h1 span,
.entry h2 span,
.entry h3 span,
.entry h4 span,
.entry h5 span,
.entry h6 span {
  color: #000;
}

/* Keep anchors that act as labels visually strong */
.lv-anchor {
  font-weight: bold;
}

/* Widget tab styles: avoid negative margin pulls */
.wpt_widget_content {
  margin: 0;
  padding: 0;
}

.wpt_widget_content .tab-content li {
  margin: 0 !important;
  padding: 0 !important;
}

/* Smaller list variant */
.display-posts-listing.image-left2 .listing-item .title {
  font-size: 14px;
}

/* Clickable text utility */
.clickable-text {
  cursor: pointer;
}

/* Remove risky mobile block that forced large min-height on the whole entry */
@media (max-width: 768px) {
  .entry.themeform {
    min-height: unset !important;
  }
}

/* Hero wrapper */
.hero-img {
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Ensure content images don’t cause surprise wraps */
.entry img.alignleft,
.entry .wp-caption.alignleft {
  float: left;
  margin: 0 16px 8px 0;
}

/* Cap caption images cleanly */
.wp-caption img {
  max-width: 100%;
  height: auto;
  display: block;
}

figure.wp-caption {
  max-width: 100%;
}

/* On narrow screens, stack to avoid float-induced CLS */
@media (max-width: 600px) {
  .entry img.alignleft,
  .entry .wp-caption.alignleft {
    float: none;
    margin: 0 0 12px 0;
  }
}

/* TOC footprint stable */
#toc_container {
  display: block !important;
  width: 100% !important;
  min-height: 56px;
  overflow: hidden;
}

#toc_container.no_bullets.contracted {
  display: block !important;
}

#toc_container * {
  line-height: 1.4;
}

/* TablePress: less reflow on load */
.tablepress table {
  width: 100%;
}

.tablepress th,
.tablepress td {
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

/* Reduce motion for users who prefer it */
@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}

/* Optional: boost long pages without hurting layout */
.archive .content,
.home .content,
.comments-area {
  content-visibility: auto;
  contain-intrinsic-size: 800px;
}

/* Small logos in headings/lists */
.entry img.wp-image-278525,
.entry img[width="50"][height="50"] {
  width: 50px;
  height: auto;
  aspect-ratio: 1 / 1;
  vertical-align: middle;
  margin-right: 8px;
}

/* Display Posts thumbnails: force a crisp 80x80 and escape global .entry img rules */
.display-posts-listing.image-left .listing-item,
.display-posts-listing.image-left2 .listing-item,
.display-posts-listing.image-home .listing-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.display-posts-listing.image-left .listing-item img,
.display-posts-listing.image-left2 .listing-item img,
.display-posts-listing.image-home .listing-item img {
  flex: 0 0 80px;
  width: 80px;
  height: 80px;
  object-fit: cover;
  display: block;
  max-width: none;
}

/* Hide date/meta for post 333846 everywhere */
article.post-333846 .post-meta,
article.post-333846 .entry-meta,
article.post-333846 .post-date,
article.post-333846 time,
.single-post.postid-333846 .entry-meta,
.single-post.postid-333846 time {
  display: none !important;
}

/* ============================================
   DISPLAY POSTS — INLINE IMAGE + TEXT FIX
   ============================================ */

/* Make the inner wrapper strong the flex container */
.display-posts-listing.image-left .listing-item > strong,
.display-posts-listing.image-home .listing-item > strong,
.display-posts-listing.image-left2 .listing-item > strong {
  display: flex;
  align-items: center;
  gap: 12px;
}

/* Ensure images behave inline and not forced block */
.display-posts-listing.image-left .listing-item img,
.display-posts-listing.image-home .listing-item img,
.display-posts-listing.image-left2 .listing-item img {
  display: inline-block !important;
  vertical-align: middle;
  max-width: none !important;
}

/* Ensure picture behaves inline too */
.display-posts-listing.image-left .listing-item picture,
.display-posts-listing.image-home .listing-item picture,
.display-posts-listing.image-left2 .listing-item picture {
  display: inline-block;
  vertical-align: middle;
}

/* =============================================
   FORCE THUMBNAIL SIZE
   ============================================= */

.display-posts-listing.image-left .listing-item img,
.display-posts-listing.image-home .listing-item img,
.display-posts-listing.image-left2 .listing-item img {
  flex: 0 0 80px;
  width: 80px !important;
  height: 80px !important;
  object-fit: cover;
  border-radius: 6px;
}

/* Prevent picture from stretching around it */
.display-posts-listing.image-left .listing-item picture,
.display-posts-listing.image-home .listing-item picture,
.display-posts-listing.image-left2 .listing-item picture {
  flex: 0 0 80px;
  width: 80px !important;
  height: 80px !important;
  overflow: hidden;
}

/* =============================================
   BRAND LOGO DETECTION — avoid ugly cropping
   ============================================= */

/* Portrait logos like Zambrero 34x60: keep aspect ratio */
.display-posts-listing.image-left .listing-item img[width="34"][height="60"],
.display-posts-listing.image-home .listing-item img[width="34"][height="60"],
.display-posts-listing.image-left2 .listing-item img[width="34"][height="60"] {
  width: 60px !important;
  height: auto !important;
  object-fit: contain;
}

/* Wide logo variants */
.display-posts-listing.image-left .listing-item img[width="120"][height="40"],
.display-posts-listing.image-home .listing-item img[width="120"][height="40"],
.display-posts-listing.image-left2 .listing-item img[width="120"][height="40"] {
  width: 80px !important;
  height: auto !important;
  object-fit: contain;
}

.author-archive-box {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin: 0 0 30px;
    padding: 24px;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
}

.author-archive-avatar img {
    border-radius: 50%;
    width: 120px;
    height: 120px;
}

.author-archive-content {
    flex: 1;
}

.author-archive-title {
    margin-top: 0;
    margin-bottom: 10px;
    font-size: 28px;
}

.author-archive-bio p {
    margin-bottom: 0;
    font-size: 16px;
    line-height: 1.6;
}

@media only screen and (max-width: 600px) {
    .author-archive-box {
        display: block;
        text-align: center;
    }

    .author-archive-avatar {
        margin-bottom: 15px;
    }
}
</style>
</head>

