            @media (min-width: 979px) {
                  #bw_affixed_ad.affix-top {
                    position: static;
                    width: 338px;
                    padding-left: 13px;
                    -webkit-transition: all .5s ease-in-out;
                    transition: all .5s ease-in-out;
                  }
                  
                  #bw_affixed_ad.affix {
                    position: fixed;
                    top: 100px;
                    width: 338px;
                    -webkit-transition: all .5s ease-in-out;
                    transition: all .5s ease-in-out;
                  }

                  #bw_affixed_ad.affix-bottom {
                    position: absolute;
                    width: 338px;
                  }
            }

