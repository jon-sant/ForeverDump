      f.parentNode.insertBefore(e, f);
    }
    if (document.querySelectorAll('a[href*="wowdb.com"]').length > 0) {
      e = document.createElement("script");
      e.async = true;
      e.src = '//www.wowdb.com/current/js/syndication/tt.js';
      f.parentNode.insertBefore(e, f);
      wowdb_log = [];
      init_wowdb_tooltips = function(tries) {
        if (tries < 10) {
          if (typeof CurseTips === 'undefined') {
            setTimeout(function() { init_wowdb_tooltips(tries+1) }, 500);
          } else {
            CurseTips['wowdb-tooltip'].watchElements(jQuery('a[href*="wowdb.com"]'));
          }
        }
      };
      init_wowdb_tooltips(0);
    }
  });
}
