        var icy_veins_blocked = false;
        var ad = document.createElement('ins');
        ad.className = 'AdSense';
        ad.style.display = 'block';
        ad.style.position = 'absolute';
        ad.style.top = '-1px';
        ad.style.height = '1px';
        document.body.appendChild(ad);
        clientHeight = ad.clientHeight;
        document.body.removeChild(ad);
        if (clientHeight) {
            var testURL = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js';
            var opts = { method: 'HEAD', mode: 'no-cors' };
            var myRequest = new Request(testURL, opts);
            fetch(myRequest).then(function(response) {
                return response;
            }).then(function(response) {
                dataLayer.push({ 'adblock': "Unblocked" });
            }).catch(function(e){
                dataLayer.push({ 'adblock': "Blocked" });
                icy_veins_blocked = true;
            });
        } else {
            dataLayer.push({ 'adblock': "Blocked" });
            icy_veins_blocked = true;
        }
    </script>
    
