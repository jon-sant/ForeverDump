                withIds.forEach(function (el) { iabLog("  child node — tag:", el.tagName, "id:", el.id); });

                var candidates = [node].concat(Array.from(node.querySelectorAll('[id^="standard_iab_rght"], [id^="standard_iab_left"]')));
                candidates.forEach(function (el) {
                  if (el.id && (el.id.indexOf("standard_iab_rght") === 0 || el.id.indexOf("standard_iab_left") === 0)) {
