static.icy-veins.com/javascript/d2-attack-speed-calculator-constants-a16014831a5204e9e26d49126a54424d.js"}}</script><script>
      // The u.gg desktop app (Electron, gitgud-frontend repo) embeds /wow in an
      // iframe as its WoW section's main content and needs us to hide our own
      // top nav — it can't reach into this cross-origin iframe's DOM to do it
      // itself. The app only controls the FIRST url it loads into the iframe,
      // so ?embed=uggapp alone would stop working the moment the user clicks
      // any internal link; sessionStorage carries the signal across in-iframe
      // navigation instead. Gated on window.self !== window.top so neither a
      // bare unframed visit to a ?embed=uggapp link, nor an unrelated site
      // iframing us, ever hides the nav.
      // window.ivEmbedMode is also read further down to skip the Ramp/Playwire
      // ad scripts for embedded u.gg sessions (the app serves its own ads).
      (function () {
        var STORAGE_KEY = "ivEmbedMode";
        var isFramed = window.self !== window.top;
        if (!isFramed) return;

        const parentWindow = window.parent;
        var embedParam = new URLSearchParams(window.location.search).get("embed");
        if (embedParam === "uggapp") {
          try { sessionStorage.setItem(STORAGE_KEY, "uggapp"); } catch (e) {}
        }

        var stored;
        try { stored = sessionStorage.getItem(STORAGE_KEY); } catch (e) { stored = null; }

        if (embedParam === "uggapp" || stored === "uggapp") {
          document.documentElement.classList.add("iv-embed-hide-nav");
          window.ivEmbedMode = true;
          blockOutboundClicks();
          routeNewWindowsToHost();
        }

        function routeNewWindowsToHost() {
          function isInternal(url) {
            return (
              url.origin === window.location.origin ||
              /(^|\.)icy-veins\.com$/i.test(url.hostname)
            );
          }

          function resolve(href) {
            try { return new URL(href, window.location.href); } catch (e) { return null; }
          }

          function requestHostNavigate(path) {
            if (!window.ivEmbedMode || parentWindow === window) return false;
            parentWindow.postMessage({ type: "uggapp:navigate", path: path }, "*");
            return true;
          }
          window.ivRequestHostNavigate = requestHostNavigate;

          document.addEventListener("click", function (event) {
            var target = event.target;
            var anchor = target && target.closest
              ? target.closest('a[href][target="_blank"]')
              : null;
            if (!anchor) return;

            var url = resolve(anchor.href);
            if (!url || !isInternal(url)) return;
            if (requestHostNavigate(url.pathname + url.search + url.hash)) {
              event.preventDefault();
            }
          }, true);

          var nativeOpen = window.open;
          window.open = function (href) {
            var url = href ? resolve(href) : null;
            if (url && isInternal(url) &&
                requestHostNavigate(url.pathname + url.search + url.hash)) {
              return null;
            }
            return nativeOpen.apply(window, arguments);
          };
        }
        function blockOutboundClicks() {
          var BLOCKED_HOSTS = /(^|\.)wowhead\.com$/i;

          function block(event) {
            var target = event.target;
            var anchor = target && target.closest ? target.closest("a[href]") : null;
            if (!anchor) return;

            var host;
            try { host = new URL(anchor.href, window.location.href).hostname; } catch (e) { return; }
            if (!BLOCKED_HOSTS.test(host)) return;

            event.preventDefault();
            event.stopPropagation();
          }

          document.addEventListener("click", block, true);
          document.addEventListener("auxclick", block, true);
        }
      })();
    </script><script>
      // These are functions that are currently hardcoded in the old site's HTML template, rather than in a JS file.
      window.getCookie ??= function (name) {
        var key = name + "=";
        var cookie = decodeURIComponent(document.cookie);
        var arr = cookie.split(";");

        for (var i = 0; i < arr.length; i++) {
          var c = arr[i];

          while (c.charAt(0) == " ") {
            c = c.substring(1);
          }

          if (c.indexOf(key) == 0) {
            return c.substring(key.length, c.length);
          }
        }

        return null;
      };

      window.icyIsPremium ??= function() {
        try {
          return window.localStorage.getItem('icy:premium') === '1'
        } catch (e) {
          return false
        }
      }

      window.writeToLocalStorage ??= function (key, content) {
        try {
          window.localStorage.setItem(key, content);
        } catch (e) {
          for (var i = 0; i < window.localStorage.length; i++) {
            const current_key = window.localStorage.key(i);
            if (
              current_key &&
              current_key != "premium_tracking" &&
              current_key != "premium_origin"
            ) {
              window.localStorage.removeItem(current_key);
            }
          }
          window.localStorage.setItem(key, content);
        }
      };
    </script><script type="text/javascript">
      if (!window.icyIsPremium()) {
