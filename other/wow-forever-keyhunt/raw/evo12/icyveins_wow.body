style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body></html> <script>
  (() => {
    const PAGE_SEL = ".wow-landing-page";
    const GROUP_SEL = ".class_overview_button_link_group";
    const LINK_SEL = "a.class_overview_button_link";

    function normalizeHref(url) {
      if (!url) return "#";
      return url.startsWith("//") ? "https:" + url : url;
    }

    function getMdPx(pageEl) {
      const raw = getComputedStyle(pageEl).getPropertyValue("--wow-md").trim();
      const num = parseInt(raw.replace("px", ""), 10);
      return Number.isFinite(num) ? num : 992;
    }

    function buildDropdown(pageEl, groupEl) {
      if (!groupEl || groupEl.dataset.dropdownBuilt === "1") return;

      const links = Array.from(groupEl.querySelectorAll(LINK_SEL));
      if (!links.length) return;

      const items = links
        .map((a) => {
          const href = normalizeHref(a.getAttribute("href") || "#");
          const img = a.querySelector("img");
          const labelEl = a.querySelector("div");
          const label = (labelEl?.textContent || "").trim();
          return {
            href,
            label,
            icon: img?.getAttribute("src") || "",
          };
        })
        .filter((x) => x.label && x.href);

      if (!items.length) return;

      const wrap = document.createElement("div");
      wrap.className = "wow-class-dropdown";
      wrap.innerHTML = `
        <button type="button" class="wow-class-dropdown__btn" aria-haspopup="listbox" aria-expanded="false">
          <span class="wow-class-dropdown__left">
            <img class="wow-class-dropdown__icon" alt="" />
            <span class="wow-class-dropdown__text">Select a Class</span>
          </span>
          <span class="wow-class-dropdown__chev" aria-hidden="true"></span>
        </button>
        <div class="wow-class-dropdown__panel" role="listbox" tabindex="-1"></div>
      `;

      const btn = wrap.querySelector(".wow-class-dropdown__btn");
      const icon = wrap.querySelector(".wow-class-dropdown__icon");
      const panel = wrap.querySelector(".wow-class-dropdown__panel");

      icon.src = items[0].icon || "";
      icon.style.visibility = items[0].icon ? "visible" : "hidden";

      panel.innerHTML = items
        .map(
          (it, idx) => `
            <button type="button" class="wow-class-dropdown__item" role="option" aria-selected="false" data-idx="${idx}">
              <img class="wow-class-dropdown__item-icon" src="${it.icon}" alt="" />
              <span class="wow-class-dropdown__item-label">${it.label}</span>
            </button>
          `,
        )
        .join("");

      function open() {
        wrap.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
        panel.focus();
      }

      function close() {
        wrap.classList.remove("is-open");
        btn.setAttribute("aria-expanded", "false");
      }

      function toggle() {
        if (wrap.classList.contains("is-open")) close();
        else open();
      }

      function goTo(idx) {
        const it = items[idx];
        if (!it) return;
        window.location.href = it.href;
      }

      btn.addEventListener("click", (e) => {
        e.preventDefault();
        toggle();
      });

      panel.addEventListener("click", (e) => {
        const itemBtn = e.target.closest(".wow-class-dropdown__item");
        if (!itemBtn) return;
        const idx = Number(itemBtn.dataset.idx);
        if (!Number.isNaN(idx)) goTo(idx);
      });

      document.addEventListener("click", (e) => {
        if (!wrap.classList.contains("is-open")) return;
        if (!wrap.contains(e.target)) close();
      });

      wrap.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          close();
          btn.focus();
        }
      });

      groupEl.parentNode?.insertBefore(wrap, groupEl);
      groupEl.dataset.dropdownBuilt = "1";
      pageEl.classList.add("has-class-dropdown");
    }

    function destroyDropdown(pageEl, groupEl) {
      const existing = pageEl.querySelector(".wow-class-dropdown");
      if (existing) existing.remove();
      if (groupEl) {
        delete groupEl.dataset.dropdownBuilt;
      }
      pageEl.classList.remove("has-class-dropdown");
    }

    function sync() {
      const pageEl = document.querySelector(PAGE_SEL);
      if (!pageEl) return;

      const groupEl = pageEl.querySelector(GROUP_SEL);
      if (!groupEl) return;

      const md = getMdPx(pageEl);
      const isMdDown = window.innerWidth < md;

      if (isMdDown) buildDropdown(pageEl, groupEl);
      else destroyDropdown(pageEl, groupEl);
    }

    let t;
    function onResize() {
      clearTimeout(t);
      t = setTimeout(sync, 100);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", sync);
    } else {
      sync();
    }
    window.addEventListener("resize", onResize);
  })();
</script>  