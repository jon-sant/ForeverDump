<body class="min-h-screen flex flex-col bg-zinc-950 text-gray-300">
  <header class='bg-zinc-900/80 backdrop-blur-md border-b border-zinc-800 sticky top-0 z-50' role='banner'>
    <div class='max-w-7xl mx-auto px-5 py-4'>
      <nav class='flex justify-between items-center' role='navigation'>
        <a href='/' class='text-2xl font-bold text-white hover:text-red-500 transition-colors tracking-tight'>
          GrabFreeGames
        </a>
  
        <!-- Mobile menu button -->
        <button
          id='mobile-menu-button'
          class='md:hidden flex flex-col gap-1.5 w-8 h-8 justify-center items-center focus:outline-none focus:ring-1 focus:ring-red-500 focus:ring-offset-zinc-900 rounded'
          aria-label='Toggle menu'
          aria-expanded='false'
        >
          <span class='block w-6 h-0.5 bg-gray-400 transition-all'></span>
          <span class='block w-6 h-0.5 bg-gray-400 transition-all'></span>
          <span class='block w-6 h-0.5 bg-gray-400 transition-all'></span>
        </button>
  
        <!-- Desktop navigation -->
        <ul class='hidden md:flex gap-8 items-center'>
            <li><a
                href='/raffles'
                class='text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium'
              >Raffles</a></li>
            <li><a
                href='/leaderboard'
                class='text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium'
              >Leaders</a></li>
            <li><a
                href='/guild'
                class='text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium'
              >Guild</a></li>
            <li><a
                href='/user/signin'
                class='text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium'
              >Sign In</a></li>
        </ul>
      </nav>
  
      <!-- Mobile navigation menu -->
      <ul id='mobile-menu' class='hidden md:hidden mt-4 pb-2 gap-4 border-t border-zinc-800 pt-4'>
          <li><a
              href='/raffles'
              class='block text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium py-2'
            >Raffles</a></li>
          <li><a
              href='/leaderboard'
              class='block text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium py-2'
            >Leaders</a></li>
          <li><a
              href='/guild'
              class='block text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium py-2'
            >Guild</a></li>
          <li><a
              href='/user/signin'
              class='block text-gray-400 hover:text-red-500 transition-colors uppercase text-sm tracking-wide font-medium py-2'
            >Sign In</a></li>
      </ul>
    </div>
  </header>  <div class="flex-1 max-w-7xl mx-auto px-5 w-full">

<main class="max-w-7xl mx-auto" role="main">


  <section class="my-12">
    <h1 class="text-2xl font-bold text-white mb-8">Latest Game Giveaways that are Free to Grab 🎮</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <article class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden hover:border-red-500/50 hover:shadow-lg hover:shadow-red-600/25 transition-all group flex flex-col">
        <a href="/free/the-descendant-ep1-free-on-steam" class="flex-1 flex flex-col">
          <div class="overflow-hidden bg-zinc-950 h-[206px] w-full lg:w-[392px]">
            <img src="img/2026/01/1768665250-888-default/thumbnail.webp" alt="Thumbnail of The Descendant EP 1 - Free on Steam" class="h-[206px] w-full lg:w-[392px] mx-auto object-cover contrast-100 group-hover:contrast-115 transition-transform duration-300" fetchpriority="high" width="392" height="206">
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h2 class="text-base md:text-lg font-bold text-white group-hover:text-red-500 transition-colors line-clamp-2">
              The Descendant EP 1 - Free on Steam
            </h2>            
          </div>
        </a>
      </article>
    </div>
  </section>


  <!-- Blog Posts Listing Section -->
  <section class="my-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-white">Raffles that are ending soon 🎟️</h2>
      <a href="/raffles" class="text-sm text-gray-400 hover:text-red-400 transition-colors">View all →</a>
    </div>
    <div class="flex flex-col gap-3">
      <a href="/raffles/6aa65e8cc029aa89b3b2aa70" class="flex items-center gap-3 md:gap-5 bg-zinc-900 border border-zinc-800 rounded-xl p-3 md:p-4 hover:border-red-500/50 hover:bg-zinc-800/50 transition-colors group">
        <div class="w-24 h-14 md:w-48 md:h-[108px] rounded-lg overflow-hidden flex-shrink-0 bg-zinc-800">
          <img src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1869370/header.jpg?t&#x3D;1782412567" alt="Sex Adventures - The Secret Club - Steam Key" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="flex-1 min-w-0 flex flex-col md:flex-row md:items-center md:gap-4">
          <p class="text-white font-semibold text-sm md:text-lg group-hover:text-red-400 transition-colors truncate md:flex-1">Sex Adventures - The Secret Club - Steam Key</p>
          <div class="flex items-center gap-4 mt-1 md:mt-0 md:shrink-0">
            <span class="text-xs md:text-sm text-gray-400 whitespace-nowrap">100 🟡</span>
            <span class="text-xs md:text-sm text-gray-500 whitespace-nowrap">36 entries</span>
            <span class="text-xs md:text-sm text-gray-500 whitespace-nowrap">Ends in 1 D</span>
          </div>
        </div>
      </a>
    </div>
  </section>


</main>

  </div>
  <footer class='bg-zinc-900 border-t border-zinc-800 py-8 mt-16 text-center' role='contentinfo'>
    <div class='max-w-6xl mx-auto px-5'>
      <form class='push-subscribe-form hidden mb-4' data-api action='/api/push/subscribe' method='POST'>
        <input type='hidden' name='endpoint' class='push-endpoint' />
        <input type='hidden' name='keys[p256dh]' class='push-p256dh' />
        <input type='hidden' name='keys[auth]' class='push-auth' />
        <button
          type='submit'
          class='push-subscribe-btn inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-300 bg-zinc-800/50 border border-zinc-700/50 rounded-lg hover:bg-zinc-700 hover:text-white transition-colors cursor-pointer'
          aria-label='Subscribe to push notifications'
        >🔔 Notify Me</button>
      </form>
      <form class='push-unsubscribe-form hidden mb-4' data-api action='/api/push/unsubscribe' method='POST'>
        <input type='hidden' name='endpoint' class='push-endpoint' />
        <button
          type='submit'
          class='push-unsubscribe-btn inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-500 bg-zinc-800/50 border border-zinc-700/50 rounded-lg hover:bg-zinc-700 hover:text-white transition-colors cursor-pointer'
          aria-label='Unsubscribe from push notifications'
        >Unsubscribe from notifications</button>
      </form>
      <p class='text-gray-400 text-sm'>&copy;
