<script>
  const sendCustomEvent = (event, data, color) => {
    if (window.brockmanDebug) console.log('%cSend analytics event', `color: ${color}`, `event:${event}`, data);
      gtag('event', event, data);
  };

  window.sendPageViewTrackerEvent = (customPageViewEvent = 'page_view_tracker') => {
      sendCustomEvent('page_view', { page_title: document.title, page_location: window.location.href }, 'lime');
      sendCustomEvent(customPageViewEvent, {...(window.ZDUniversalParameters || {}), pvt: 1}, 'lime');
  };

  window.sendZDAnalyticsEvent = (event, category, action, label, engagement=1, useUniversalParameters=true) => {
    sendCustomEvent(event, {
      event_category: category || '',
      event_action: action || '',
      event_label: label || '',
      engagement,
      ...(useUniversalParameters ? window.ZDUniversalParameters : {}),
    }, 'blue');
  };

  window.sendZDNavigationAnalyticsEvent = (url, component, engagement=1, useUniversalParameters=true) => {
    sendCustomEvent('click_tracking', {
      click_url: url,
      component,
      engagement,
      ...(useUniversalParameters ? window.ZDUniversalParameters : {}),
    }, 'cyan');
  };
</script><script type='text/javascript'>
