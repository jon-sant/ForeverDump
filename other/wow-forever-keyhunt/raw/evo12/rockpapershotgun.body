      window.sendPageViewTrackerEvent();

      document.addEventListener('click', (e) => {
        const el = e.target.closest('a[href]');
        if (!el) return;
        const component = el.closest('[data-component]')?.dataset.component;
        if (!component) return;
        const url = el.href;
        window.sendZDNavigationAnalyticsEvent(url, component);
      });
    });
