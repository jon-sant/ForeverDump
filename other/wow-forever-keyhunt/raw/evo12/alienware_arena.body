1":2404},"YT":{"1":2404},"ZA":{"1":2404},"ZM":{"1":2404},"ZW":{"1":2404}};
    var $giveawayActions      = $('#giveaway-actions');
    var $keyActions           = $('#get-key-actions');
    var $heroKeyCount         = $('.giveaway-status-wrapper .giveaway-key-count');
    var $noKeysLeft           = $('#no-keys-left');
    var $getKey               = $('#giveaway-get-key');
    var $containerOtp         = $('.container-otp', $keyActions);
    var successMessage        = '\u003Cp\u003EKey\u003A\u0020\u0025assignedKey\u0025\u003C\/p\u003E\n\u003Cp\u003EPlease\u0020follow\u0020the\u0020instructions\u0020below\u0020to\u0020activate\u0020your\u0020key.\u0020If\u0020you\u0020require\u0020any\u0020additional\u0020support,\u0020please\u0020email\u0020\u003Ca\u0020href\u003D\u0022mailto\u003Acontact\u0040alienwarearena.com\u0022\u003Econtact\u0040alienwarearena.com\u003C\/a\u003E.\u003C\/p\u003E\n\u0020\u0020\u0020\u0020\u003Cul\u0020class\u003D\u0022giveaway\u002Dredemption\u002Dsteps\u0022\u003E\n\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u003Cli\u003E1.\u0020\u003Ca\u0020href\u003D\u0022https\u003A\/\/store.steampowered.com\/app\/4126040\/Aniimo\/\u0022\u003EDownload\u0020and\u0020install\u0020Aniimo.\u003C\/a\u003E\u003C\/li\u003E\n\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u003Cli\u003E2.\u0020Go\u0020to\u0020System\u0020Menu,\u0020then\u0020Settings.\u003C\/li\u003E\n\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u003Cli\u003E3.\u0020Click\u0020Account\u0020Settings,\u0020then\u0020Gift\u0020Code\u0020Redemption.\u003C\/li\u003E\n\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u003Cli\u003E4.\u0020Click\u0020Enter\u0020Gift\u0020Code\u0020and\u0020hit\u0020Redeem\u0020to\u0020redeem\u0020your\u0020key.\u003C\/li\u003E\n\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u003Cli\u003E5.\u0020Keys\u0020are\u0020valid\u0020until\u0020October\u002030,\u00202026.\u003C\/li\u003E\n\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\n\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u0020\u003C\/ul\u003E\n\n';
    var token                 = {"token":"n\/a"};
    var giveawayHCaptchaWidgetId = null;
    var giveawayCaptchaPending = null;
    window.isGiveawayOpen     = true;

    function initGiveawayHCaptcha() {
        if (!document.getElementById("hcaptcha-giveaway-container")) {
            return;
        } 

        if (giveawayHCaptchaWidgetId === null) {
            giveawayHCaptchaWidgetId = hcaptcha.render("hcaptcha-giveaway-container", {
                sitekey: (window.hcaptchaSiteKey),
                size: "invisible",
                callback: onGiveawayCaptchaSolved,
                "error-callback": onGiveawayCaptchaError,
                "expired-callback": onGiveawayCaptchaExpired
            });
        }
    }

    function ensureHCaptchaReady(cb) {
        (function wait() {
            if (window.hcaptcha && typeof window.hcaptcha.render === "function") {
                initGiveawayHCaptcha();
                cb();
                return;
            }
            setTimeout(wait, 50);
        })();
    }

    function startGiveawayCaptcha(href) {
        giveawayCaptchaPending = { href: href, sent: false };

        ensureHCaptchaReady(function () {
            try {
                hcaptcha.execute(giveawayHCaptchaWidgetId);
            } catch (e) {
                onGiveawayCaptchaError();
            }
        });
    }

    function onGiveawayCaptchaSolved(captchaToken) {
        if (!giveawayCaptchaPending || giveawayCaptchaPending.sent) {
            try { 
                hcaptcha.reset(giveawayHCaptchaWidgetId); 
            } catch (e) {

            }
            return;
        }

        giveawayCaptchaPending.sent = true;

        var hrefWithCaptcha =
            giveawayCaptchaPending.href +
            '&recaptcha_token=' +
            encodeURIComponent(captchaToken);

        giveawayCaptchaPending = null;

        doKeyRequestAjax(hrefWithCaptcha);
    }

    function onGiveawayCaptchaError() {
        try {
             if (giveawayHCaptchaWidgetId !== null) {
                hcaptcha.reset(giveawayHCaptchaWidgetId);
             } 
        } catch (e) {

        }
        
        giveawayCaptchaPending = null;
        $getKey.button('reset');
        $getKey.attr('aria-disabled', 'false').css('pointer-events', 'auto')
        $getKey.parent().css({'cursor': 'pointer'});
        showFlashMessage("Captcha validation failure. Please try again.", "error", false);
    }

    function onGiveawayCaptchaExpired() {
        if (giveawayCaptchaPending && !giveawayCaptchaPending.sent) {
            try { 
                hcaptcha.execute(giveawayHCaptchaWidgetId); 
            } catch (e) { 
                onGiveawayCaptchaError(); 
            }
        }
    }
    
    function doKeyRequestAjax(href) {
        $.ajax({
            url: href,
            headers: { 'Authorization': token['token'] },
            success: function (data) {
                if (data.hasOwnProperty('successMessage')) {
                                            showFlashMessage("Loading...", "info");
                                        clearTimeout(checkKeysTimeout);
                    refreshKeys(1);
                }

                handleFailedKeyResponse(data);
            },
            statusCode: {
                400: function (res) {
                    var msg = res.responseJSON;

                    handleFailedKeyResponse(msg);
                },
                403: function (res) {
                    var msg = {
                        ...res.responseJSON,
                        statusCode: 403   
                    };

                    handleFailedKeyResponse(msg);
                }
            },
            complete: function () {
                try {
                    if (giveawayHCaptchaWidgetId !== null) {
                        hcaptcha.reset(giveawayHCaptchaWidgetId);
                    } 
                } catch (e) {

                }
            }
        });
    }

    if(!user_is_logged_in){
        $('#mfa-disabled').remove();
        $('#mfa-enabled').remove();
    }else{
        $('#showOnLogin').remove();

            if(user_has_mfa){
            $('#mfa-disabled').remove();
        }else{
            $('#mfa-enabled').remove();
        }
    }

    
    extraInfo.loginId     = login_id;
    extraInfo.countryCode = user_country;
    extraInfo.userId      = user_id;

    function nl2br(str, is_xhtml) {
        if (typeof str === 'undefined' || str === null) {
            return '';
        }

        var breakTag = (is_xhtml || typeof is_xhtml === 'undefined') ? '<br ' + '/>' : '<br>';

        return (str + '').replace(/([^>\r\n]?)(\r\n|\n\r|\r|\n)/g, '$1' + breakTag + '$2');
    }

    function refreshKeys(intervalSec) {
        intervalSec = intervalSec || 60;
        $.when(
            $.getJSON("/giveaways/keys", function(data) {
                giveawayKeys = data;
            })
        ).done(function() {
            checkKeys(intervalSec);
        })
    }

    function checkKeys(intervalSec) {
        intervalSec = intervalSec || 60;

        for (var i = giveawayKeys.length - 1; i >= 0; i--) {
            var id = giveawayKeys[i].giveaway_id;
            if (id == 2176243) {
                var key = giveawayKeys[i].value.replace(/\\n/g, "\n");
                key = key.replace(/\\r/g, "\r");

                showFlashMessage(successMessage.replace('%assignedKey%', nl2br(key)));
                return;
            }
        };

        if (refreshKeysEnabled) {
            checkKeysTimeout = setTimeout(refreshKeys, intervalSec * 1000);
        }
    }
    
    function submitKeyRequest(otp) {
        if ($getKey.attr('href')) {
            return;
        }

        
        var href = $getKey.data('href');

        
        $getKey.attr('aria-disabled', 'true')[0].style.setProperty('pointer-events', 'none', 'important');;
        $getKey.parent()[0].style.setProperty('cursor', 'not-allowed', 'important');;
        $getKey.button('loading');

        href = href + '&extra_info=' + encodeURIComponent(JSON.stringify(extraInfo));
        
        
        startGiveawayCaptcha(href);
    }

    function handleFailedKeyResponse(res) {

        try {
            if (giveawayHCaptchaWidgetId !== null) {
                hcaptcha.reset(giveawayHCaptchaWidgetId);
            } 
        } catch (e) {

        }
        
        giveawayCaptchaPending = null;

        if (res.hasOwnProperty('errorMessage')) {
            if (res.errorMessage == 'RecaptchaNotValidError') {
                showFlashMessage("reCAPTCHA validation failure. Please try again in a few minutes.", "error", false);
            } else {
                if ("genericError" in res && !res.genericError) {
                    showFlashMessage(res.errorMessage, "error", false);
                } else {
                    showFlashMessage("<p>Unfortunately, a key could not be assigned to you. This can occur for one of several reasons, including: <br /><br /> 1) We've ran out of keys before we could assign one to you while you were in the queue.<br /> 2) You are in a country or region that is not eligible to receive a key.<br /> 3) A key has already been assigned to you.<br /> 4) reCAPTCHA validation failure.</p> ", "error", false);
                }

                refreshKeysEnabled = false;
                clearTimeout(checkKeysTimeout);
            }
        } else if (res.authenticatorRequired) {
            $getKey.hide();
            $containerOtp.otp();
            $containerOtp.on('otp:submit', function(e, data) {
                $containerOtp.otp('loading');
                submitKeyRequest(data.otp);
            });
        } else if(res.statusCode == 403) {
            showFlashMessage('Unauthorized', "error", false);
        }

        $getKey.button('reset');
        $getKey.attr('aria-disabled', 'false').css('pointer-events', 'auto');
        $getKey.parent().css({'cursor': 'pointer'});
        $containerOtp.length && $containerOtp.otp('reset');
    }

    $(function() {
        if (countryKeys.hasOwnProperty(user_country)) {
            var userCountryKeys = countryKeys[user_country];

            var lowestTierWithKeys;
            var highestKeysForUser;
            var keysForUser = false;

            for (var tier in userCountryKeys) {
                if (userCountryKeys[tier] > 0) {
                    if (!lowestTierWithKeys) { lowestTierWithKeys = tier; }
                    if (arp_tier >= tier) {
                        if (!highestKeysForUser || userCountryKeys[tier] > highestKeysForUser) { highestKeysForUser = userCountryKeys[tier]; }
                    }
                }
            }
            
            if (highestKeysForUser) {
                $('.key-count').html(highestKeysForUser);
                $keyActions.show();
                keysForUser = true;
            }

            if (!keysForUser) {
                if (lowestTierWithKeys) {
                    $('#keys-required-tier').html(lowestTierWithKeys);
                    $('#no-keys-left-until-tier').show();
                } else {
                    $noKeysLeft.show();
                    $heroKeyCount.hide();
                    window.isGiveawayOpen = false;
                }
            }

        } else {
            $('.key-count').html('0');
            $noKeysLeft.show();
            $heroKeyCount.hide();
            window.isGiveawayOpen = false;
        }

        $giveawayActions.fadeIn();

        $('#giveaway-flash-message').append($('#giveaway-flash-wrapper').show());

        if (!user_is_logged_in) {
            $getKey.attr('href', "/login?return=" + encodeURIComponent(window.location.pathname));

                    } else {
                            $getKey.data('href', $getKey.data('href') + user_uuid);
                    }

        $getKey.click(function(e) {
            e.preventDefault();
            
            if ($getKey.attr('href')) { window.location.href = $getKey.attr('href'); return; }

                            $('#arp-confirmation-modal').modal('show');
                return false;
            
            submitKeyRequest();
        });

                $('#confirm-arp-spend').click(function() {
            $('#arp-confirmation-modal').modal('hide');
            submitKeyRequest();
        });
        
        
        
        
        
        $('.reg-source').click(function() {
            var $ele = $(this);
            if ($ele.prop("tagName") == "A" && $ele.attr('href') === undefined) { return; }
            addSourceInfo(this, 'eyJ0eXBlIjpudWxsLCJpZCI6MjE3NjI0M30=');
        });

        checkKeys();
    });
</script>
